# --- secrets: never commit these ---
deploy/keys/
*.pem
*private*.key
.itam-release/
.ongc_pgpass
.itam_smtp_secret
*_admin.txt

# --- real inventory / HR data (personal data - bank details, mobile numbers, addresses): never commit ---
/data/
/masters/
/backups/
/uploads/
/samples/
/*.xlsx
portal/backups/
portal/service/logs/

# --- build artifacts and dependency installs: regenerated by build-release.ps1 / run_portal.ps1, not source ---
portal/.venv/
portal/static/
portal/frontend/node_modules/
portal/frontend/.tmp-icons/
deploy/images/
deploy/releases/
dpendancy/

# --- caches / tool-local state ---
__pycache__/
*.pyc
.pytest_cache/
.claude/

# generated by the graphify knowledge-graph tool (a cache, not source)
graphify-out/

# Internal network data (router names, IPs, site names): never commit - this repository is public
templates/Leased_MPLS_Circuit_Details_Request.xlsx

# Trend Micro / inventory reports: real machine and engineer data, never for a public repository
reports/

# Ruflo tooling state (local agent memory and daemon files)
.swarm/
