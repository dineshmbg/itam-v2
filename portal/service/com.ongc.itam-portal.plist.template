<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ongc.itam-portal</string>
  <key>ProgramArguments</key><array>
    <string>__PROJECT__/portal/run_portal.sh</string><string>--no-browser</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key>
    <string>/opt/homebrew/opt/postgresql@18/bin:/Applications/Postgres.app/Contents/Versions/18/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>WorkingDirectory</key><string>__PROJECT__/portal</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__PROJECT__/portal/service/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/portal/service/logs/launchd.err.log</string>
</dict></plist>
