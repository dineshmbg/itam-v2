@echo off
setlocal EnableExtensions EnableDelayedExpansion
rem ANK software check. Reads this PC only: installs nothing, changes nothing, needs no administrator rights, no PowerShell.
rem It creates ONE file, ankcheck_<computer name>.txt, in the folder this script is run from (the share), and sends its content to the ITAM portal.
rem Only if that folder cannot be written does it save the file in the user's Documents folder instead.
rem Run with the argument  nopause  from a logon script so it never waits for a key.
set "URL=__URL__"
set "TOKEN=__TOKEN__"
set "HERE=%~dp0"
set "OUT=%HERE%ankcheck_%COMPUTERNAME%.txt"
set "ELSEWHERE=0"
(type nul > "%OUT%") 2>nul
if not exist "%OUT%" (
  set "ELSEWHERE=1"
  set "OUT=%USERPROFILE%\Documents\ankcheck_%COMPUTERNAME%.txt"
  (type nul > "!OUT!") 2>nul
)
if not exist "%OUT%" (
  echo Cannot create the result file here or in Documents. Nothing was checked.
  if /i not "%~1"=="nopause" pause
  exit /b 1
)
pushd "%~dp0" 2>nul

echo ANK software check on %COMPUTERNAME% ...
set "CV=HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
call :rv "%CV%" ProductName WIN_PRODUCT
call :rv "%CV%" CurrentBuildNumber WIN_BUILD
call :rv "%CV%" UBR WIN_UBR
call :rv "%CV%" DisplayVersion WIN_DISPLAY
call :rv "%CV%" InstallationType WIN_INSTALLTYPE
if /i "!WIN_UBR:~0,2!"=="0x" set /a WIN_UBR=!WIN_UBR!

call :prog "Trend Micro" TREND
call :prog "BigFix" BIGFIX
call :prog "Zscaler" ZSCALER
call :prog "SAP GUI" SAP
call :prog "Google Chrome" CHROME
call :prog "Mozilla Firefox" FIREFOX
if not defined TREND_NAME call :prog "Apex One" TREND
if not defined TREND_NAME call :prog "OfficeScan" TREND
if not defined TREND_NAME call :prog "Worry-Free" TREND
if not defined TREND_NAME call :prog "Security Agent" TREND_CANDIDATE
if not defined ZSCALER_NAME call :prog "ZSA" ZSCALER_CANDIDATE
rem Generic-name candidates are diagnostics only, not confirmed product identities.
call :service TmListen TREND_LISTENER_STATE
call :service ntrtscan TREND_SCAN_STATE
call :service ZSAService ZSCALER_SERVICE_STATE
call :service BESClient BIGFIX_SERVICE_STATE
if not defined TREND_NAME if defined TREND_LISTENER_STATE set "TREND_NAME=Trend Micro - detected by TmListen service"
if not defined TREND_NAME if defined TREND_SCAN_STATE set "TREND_NAME=Trend Micro - detected by ntrtscan service"
if not defined ZSCALER_NAME if defined ZSCALER_SERVICE_STATE set "ZSCALER_NAME=Zscaler - detected by ZSAService service"
if not defined TREND_VER call :rv "HKLM\SOFTWARE\TrendMicro\PC-cillinNTCorp\CurrentVersion" ProgramVer TREND_VER
if not defined TREND_VER call :rv "HKLM\SOFTWARE\WOW6432Node\TrendMicro\PC-cillinNTCorp\CurrentVersion" ProgramVer TREND_VER
set "TREND_STATUS=NOT_DETECTED"
if defined TREND_NAME set "TREND_STATUS=DETECTED"
set "ZSCALER_STATUS=NOT_DETECTED"
if defined ZSCALER_NAME set "ZSCALER_STATUS=DETECTED"
set "WIN_PRODUCT_RAW=!WIN_PRODUCT!"
rem Windows client builds 22000 and later belong to Windows 11.
if /i "!WIN_INSTALLTYPE!"=="Client" if defined WIN_BUILD if !WIN_BUILD! GEQ 22000 set "WIN_PRODUCT=!WIN_PRODUCT:Windows 10=Windows 11!"
sc query BESClient >nul 2>&1 && set "BIGFIX_SVC=1" || set "BIGFIX_SVC=0"

set "VPN_OTHER="
for %%P in ("GlobalProtect" "AnyConnect" "FortiClient" "Pulse Secure" "OpenVPN" "Check Point" "WireGuard" "NordVPN" "Cisco Secure Client") do (
  call :prog %%P VPNX
  if defined VPNX_NAME set "VPN_OTHER=!VPN_OTHER!!VPNX_NAME!; "
)

set "O365_ACCOUNT="
set "O365_ACCOUNT_SOURCE="
for %%F in (EmailAddress UserName ADALUserName) do (
  if not defined O365_ACCOUNT call :account "HKCU\Software\Microsoft\Office\16.0\Common\Identity\Identities" %%F
)
if not defined O365_ACCOUNT call :account "HKCU\Software\Microsoft\Office\16.0\Common\Identity" ADALUserName
set "O365_STATUS=NOT_DETECTED_IN_CURRENT_USER_REGISTRY"
if defined O365_ACCOUNT set "O365_STATUS=REGISTRY_IDENTITY_FOUND_NOT_VERIFIED_ACTIVE"
call :rv "HKLM\SOFTWARE\Microsoft\Office\ClickToRun\Configuration" VersionToReport OFFICE_VER
call :rv "HKLM\SOFTWARE\Microsoft\Office\ClickToRun\Configuration" UpdateChannel OFFICE_CHANNEL
call :rv "HKCU\Software\Microsoft\Edge\BLBeacon" version EDGE_VER
if not defined EDGE_VER call :prog "Microsoft Edge" EDGEX
if not defined EDGE_VER if defined EDGEX_VER set "EDGE_VER=!EDGEX_VER!"
call :rv "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" Domain DOMAIN
call :rv "HKLM\SYSTEM\CurrentControlSet\Control\SecureBoot\State" UEFISecureBootEnabled SECUREBOOT
if /i "!SECUREBOOT!"=="0x1" (set "SECUREBOOT=1") else if defined SECUREBOOT set "SECUREBOOT=0"
set "LAST_USER=%USERDOMAIN%\%USERNAME%"

rem The result file: the KEY=VALUE lines, then the Windows update events and the installed-software list (the portal reads them into its own tables).
rem Everything is written straight into this one file - no other file is created.
(
  echo ANKCHECK=1
  echo(COMPUTER=%COMPUTERNAME%
  echo(RUN_AT_RAW=%DATE% %TIME%
  for %%V in (WIN_PRODUCT_RAW WIN_PRODUCT WIN_BUILD WIN_UBR WIN_DISPLAY WIN_INSTALLTYPE TREND_STATUS TREND_NAME TREND_VER TREND_LISTENER_STATE TREND_SCAN_STATE TREND_CANDIDATE_NAME TREND_CANDIDATE_VER BIGFIX_SVC BIGFIX_NAME BIGFIX_VER BIGFIX_SERVICE_STATE ZSCALER_STATUS ZSCALER_NAME ZSCALER_VER ZSCALER_SERVICE_STATE ZSCALER_CANDIDATE_NAME ZSCALER_CANDIDATE_VER VPN_OTHER SAP_VER O365_STATUS O365_ACCOUNT O365_ACCOUNT_SOURCE OFFICE_VER OFFICE_CHANNEL EDGE_VER CHROME_NAME CHROME_VER FIREFOX_NAME FIREFOX_VER DOMAIN SECUREBOOT LAST_USER) do echo(%%V=!%%V!
  echo [UPDATES]
) > "%OUT%"
wevtutil qe System /q:"*[System[Provider[@Name='Microsoft-Windows-WindowsUpdateClient'] and (EventID=19)]]" /rd:true /c:300 /f:text >> "%OUT%" 2>nul
findstr /c:"Event[" "%OUT%" >nul || wevtutil qe Microsoft-Windows-WindowsUpdateClient/Operational /q:"*[System[(EventID=19)]]" /rd:true /c:300 /f:text >> "%OUT%" 2>nul
>> "%OUT%" echo [SOFTWARE]
call :softwareraw >> "%OUT%" 2>nul

set "CODE=000"
where curl.exe >nul 2>&1 && for /f %%c in ('curl.exe -s -k -m 60 -o nul -w "%%{http_code}" -H "X-Check-Token: %TOKEN%" --data-binary "@%OUT%" "%URL%/api/software/check" 2^>nul') do set "CODE=%%c"
if "!CODE!"=="200" (
  echo Done. The result was recorded in the ITAM portal.
  goto :end
)
if "!CODE!"=="422" (echo The portal does not know %COMPUTERNAME% as a desktop, workstation or server. Tell the IT helpdesk. & goto :end)
echo Could not reach the portal ^(code !CODE!^). The result is saved in the file below.
if "!ELSEWHERE!"=="1" echo The folder this script runs from could not be written, so the file is in Documents - please send it to the IT helpdesk.
:end
echo Result file: "%OUT%"
popd 2>nul
if /i not "%~1"=="nopause" pause
exit /b 0

:rv
rem :rv "KEY" ValueName VARIABLE  -> VARIABLE = that registry value (blank if absent)
set "%~3="
for /f "tokens=2,*" %%a in ('reg query "%~1" /v %~2 2^>nul ^| findstr /i /r /c:"^[ ]*%~2[ ]*REG_"') do set "%~3=%%b"
exit /b

:prog
rem :prog "text" NAME  -> NAME_NAME / NAME_VER of the first installed program whose DisplayName contains the text.
rem reg query cannot filter on DisplayName alone (with /v it ignores /f and lists every program), so the name is checked here.
set "%~2_NAME="
set "%~2_VER="
for %%R in ("HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall" "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" "HKCU\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall") do (
  for /f "delims=" %%K in ('reg query %%R /s /f "%~1" /d 2^>nul ^| findstr /b /i "HKEY_"') do (
    if not defined %~2_NAME (
      call :rv "%%K" DisplayName TMPN
      if defined TMPN (echo(!TMPN!| findstr /i /c:"%~1" >nul && (set "%~2_NAME=!TMPN!" & call :rv "%%K" DisplayVersion %~2_VER))
    )
  )
)
exit /b

:service
set "%~2="
for /f "tokens=3" %%S in ('sc query "%~1" 2^>nul ^| findstr /r /c:":  *[1-7]  "') do if not defined %~2 set "%~2=%%S"
exit /b

:account
for /f "tokens=1,2,*" %%A in ('reg query "%~1" /s /v "%~2" 2^>nul ^| findstr /i /r /c:"^[ ]*%~2[ ]*REG_"') do (
  set "ACCOUNT_CANDIDATE=%%C"
  if not "!ACCOUNT_CANDIDATE:@=!"=="!ACCOUNT_CANDIDATE!" if not defined O365_ACCOUNT (
    set "O365_ACCOUNT=%%C"
    set "O365_ACCOUNT_SOURCE=%~1 / %~2"
  )
)
exit /b

:softwareraw
for %%R in ("HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall" "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" "HKCU\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall") do (
  echo Source: %%~R
  reg query %%R /s 2>nul | findstr /i /r /c:"^HKEY" /c:"^[ ]*DisplayName[ ]" /c:"^[ ]*DisplayVersion[ ]" /c:"^[ ]*Publisher[ ]"
)
exit /b
